{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riazcs",
  "compatibility_date": "2026-09-22",
  "main": "./riaz-portfolio/src/worker.js",
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "directory": "./riaz-portfolio/dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}